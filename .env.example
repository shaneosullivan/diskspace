# Local credentials for the release scripts. Not committed: .gitignore keeps it
# out, because the repository is public and an Apple ID is the username half of
# a developer account.
#
# Source it before building a release:
#   set -a; . ./.env; set +a
#   ./scripts/export-macos-app.sh

# Apple Developer Team ID. `security find-identity -v -p codesigning`
# shows it in parentheses after the certificate name.
DISKSPACE_TEAM_ID=XXXXXXXXXX

# Apple ID for the developer account that signs and notarizes the app.
DISKSPACE_APPLE_ID=you@example.com
