#include <windows.h>

#include "resource.h"
#include "product.h"

// The manifest is compiled in rather than shipped beside the executable, so a
// single file carries its own DPI, long-path and common-controls settings.
1 RT_MANIFEST "app.manifest"

// Lowest id wins as the executable's shell icon, so this one is also what
// Explorer and the taskbar show.
IDI_APPICON ICON "..\\..\\Packaging\\AppIcon.ico"

// The same artwork the macOS app uses, taken from the shared assets folder
// rather than copied, so the two cannot drift. Kept as PNG and decoded at the
// size and colour it is drawn at.
IDB_COLLAPSE  RCDATA "..\\..\\..\\assets\\images\\collapse.png"
IDB_SIDE_HIDE RCDATA "..\\..\\..\\assets\\images\\side_hide.png"
IDB_SIDE_SHOW RCDATA "..\\..\\..\\assets\\images\\side_show.png"

IDR_ACCELERATORS ACCELERATORS
BEGIN
    "O",            IDM_OPEN,               VIRTKEY, CONTROL
    "R",            IDM_REFRESH,            VIRTKEY, CONTROL
    "C",            IDM_COPY_PATH,          VIRTKEY, CONTROL
    VK_OEM_COMMA,   IDM_PREFERENCES,        VIRTKEY, CONTROL
    VK_ESCAPE,      IDM_STOP,               VIRTKEY
    VK_DELETE,      IDM_RECYCLE,            VIRTKEY
    VK_OEM_PLUS,    IDM_ZOOM_IN,            VIRTKEY, CONTROL
    VK_OEM_MINUS,   IDM_ZOOM_OUT,           VIRTKEY, CONTROL
    VK_BACK,        IDM_ZOOM_OUT,           VIRTKEY
END

VS_VERSION_INFO VERSIONINFO
    FILEVERSION DISKSPACE_VERSION_MAJOR,DISKSPACE_VERSION_MINOR,DISKSPACE_VERSION_PATCH,DISKSPACE_VERSION_REVISION
    PRODUCTVERSION DISKSPACE_VERSION_MAJOR,DISKSPACE_VERSION_MINOR,DISKSPACE_VERSION_PATCH,DISKSPACE_VERSION_REVISION
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS 0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Chofter Apps"
            VALUE "FileDescription", DISKSPACE_APP_NAME
            VALUE "FileVersion", DISKSPACE_VERSION_STRING_FULL
            VALUE "InternalName", "DiskSpace"
            VALUE "OriginalFilename", "DiskSpace.exe"
            VALUE "ProductName", DISKSPACE_APP_NAME
            VALUE "ProductVersion", DISKSPACE_VERSION_STRING_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
