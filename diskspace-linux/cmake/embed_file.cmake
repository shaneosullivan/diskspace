# Turn a binary file into a C++ array so it can be compiled into the binary.
#
# The application ships as one file that needs nothing beside it, so the icon
# cannot be loaded from a path at runtime: an AppImage is mounted somewhere
# different every launch, and the loose binary might be anywhere at all.
#
# Invoked as a script:
#   cmake -DINPUT=... -DOUTPUT=... -DSYMBOL=... -P embed_file.cmake

file(READ "${INPUT}" HEX_CONTENT HEX)
string(LENGTH "${HEX_CONTENT}" HEX_LENGTH)
math(EXPR BYTE_COUNT "${HEX_LENGTH} / 2")

# Two hex characters per byte, wrapped so the generated file is something a
# person can open without their editor giving up.
string(REGEX REPLACE "(..)" "0x\\1," BYTES "${HEX_CONTENT}")
string(REGEX REPLACE "((0x..,){12})" "\\1\n    " BYTES "${BYTES}")

file(WRITE "${OUTPUT}"
"// Generated by cmake/embed_file.cmake from ${INPUT}. Do not edit.
#pragma once

#include <cstddef>
#include <cstdint>

inline constexpr size_t ${SYMBOL}Size = ${BYTE_COUNT};
inline constexpr uint8_t ${SYMBOL}[] = {
    ${BYTES}
};
")
